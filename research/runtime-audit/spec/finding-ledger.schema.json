{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alms.dev/runtime-audit-finding-ledger/v0",
  "title": "Consolidated Finding Ledger v0",
  "$comment": "AUDIT INFRASTRUCTURE ONLY (P0.7C). Machine-readable consolidation of Phase 0 findings and installed-behavior observations. generated_offline MUST be true for artifacts produced during offline Phase 0 work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "generated_offline", "disclaimer", "findings", "observations"],
  "properties": {
    "spec": { "const": "alms.dev/runtime-audit-finding-ledger/v0" },
    "generated_offline": { "const": true },
    "disclaimer": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "$comment": "Each item MUST also validate against finding.schema.json (alms.dev/runtime-audit-finding/v0); validated separately because draft-2020-12 $ref resolution is not wired in the harness loader."
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lane", "title", "summary", "evidence_source", "blocking"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "lane": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "evidence_source": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "owner": { "type": "string" },
          "next_action": { "type": ["string", "null"] }
        }
      }
    }
  }
}
