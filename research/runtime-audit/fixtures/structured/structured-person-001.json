{
  "spec": "alms.dev/runtime-audit-fixture/v0",
  "id": "structured-person-001",
  "feature": "structured_output",
  "summary": "Extract a flat typed object (name, age) from a sentence.",
  "messages": [
    {
      "role": "user",
      "parts": [{ "kind": "text", "text": "Alice is 30 years old." }]
    }
  ],
  "output_schema": {
    "type": "object",
    "required": ["name", "age"],
    "properties": {
      "name": { "type": "string" },
      "age": { "type": "integer" }
    },
    "additionalProperties": false
  },
  "requirements": {
    "live_required": true,
    "supports_mock_mode": false,
    "capabilities": ["generation", "structured_output"],
    "tier": "base"
  },
  "execution": {
    "temperature": 0,
    "max_output_tokens": 128,
    "timeout_ms": 30000,
    "stream": false,
    "max_attempts": 1
  },
  "expected_invariants": {
    "schema_valid": true,
    "expected_fields_equal": { "name": "Alice", "age": 30 }
  }
}
